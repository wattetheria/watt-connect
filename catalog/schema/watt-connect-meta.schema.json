{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wattetheria/watt-connect/catalog/schema/watt-connect-meta.schema.json",
  "title": "watt-connect catalog entry",
  "description": "An MCP registry server.json document whose _meta[\"watt/connect\"] carries the watt-connect extension. Only the parts watt-connect relies on are constrained here; semantic checks live in `watt-connect-catalog validate`.",
  "type": "object",
  "required": ["name", "description", "version", "_meta"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+/[a-z0-9_.-]+$" },
    "title": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": { "type": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
      }
    },
    "packages": { "type": "array" },
    "_meta": {
      "type": "object",
      "required": ["watt/connect"],
      "properties": { "watt/connect": { "$ref": "#/$defs/connect" } }
    }
  },
  "$defs": {
    "connect": {
      "type": "object",
      "required": ["status", "modes"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["active", "deprecated", "revoked"] },
        "category": { "type": "array", "items": { "type": "string" } },
        "credential": { "$ref": "#/$defs/credential" },
        "auth_failure": { "type": "array", "items": { "$ref": "#/$defs/matcher" } },
        "rate_limited": { "type": "array", "items": { "$ref": "#/$defs/matcher" } },
        "protocol_versions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "modes": {
          "type": "object",
          "required": ["proxy", "direct"],
          "additionalProperties": false,
          "properties": {
            "proxy": { "type": "boolean" },
            "direct": { "type": "boolean" },
            "default": { "enum": ["proxy", "direct"] }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preview_before": { "type": "object", "additionalProperties": { "type": "string" } },
            "payment_link_fields": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "effect"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "effect": { "enum": ["read", "write", "order"] }
            }
          }
        },
        "sandbox": {
          "type": "object",
          "required": ["url"],
          "properties": { "url": { "type": "string", "format": "uri" } }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "credential": {
      "type": "object",
      "required": ["kind", "placement", "portal_url"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["static_token"] },
        "placement": {
          "type": "object",
          "required": ["in", "name"],
          "additionalProperties": false,
          "properties": {
            "in": { "enum": ["header", "query"] },
            "name": { "type": "string", "minLength": 1 },
            "format": { "type": "string", "pattern": "\\{token\\}" }
          }
        },
        "portal_url": { "type": "string", "format": "uri" },
        "ttl_hint_days": { "type": "integer", "minimum": 1 },
        "redact_patterns": { "type": "array", "items": { "type": "string", "format": "regex" } }
      }
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body_contains": { "type": "string", "minLength": 1 },
        "jsonrpc_error_code": { "type": "integer" },
        "json_path": { "type": "string", "pattern": "^\\$" },
        "equals": {}
      },
      "dependentRequired": { "equals": ["json_path"] }
    }
  }
}
